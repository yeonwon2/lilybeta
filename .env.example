# =============================================================================
# LilyBeta Environment Configuration
# =============================================================================

# Server Ports
PORT=3006
BACKEND_PORT=3006
CLIENT_PORT=3005

# Environment (development | production | test)
NODE_ENV=development

# Database Provider (sqlite | postgres)
# Development/Test: 'sqlite' is permitted.
# Production: 'postgres' is strictly required (server will fail fast if sqlite is configured in production).
DATABASE_PROVIDER=sqlite

# Local SQLite Database Path (used when DATABASE_PROVIDER=sqlite)
DB_PATH=./data/lilybeta.db

# PostgreSQL / Supabase Connection URL (used when DATABASE_PROVIDER=postgres)
# Example (Direct 5432): postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
# Example (Supavisor Transaction Pooler 6543): postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Optional Supabase metadata (not required for direct SQL persistence)
SUPABASE_URL=https://your-project.supabase.co
# WARNING: NEVER expose service role key to frontend! Keep server-side only.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection Pool Limit (default: 10)
DB_POOL_MAX=10

# JWT Secret Key (MUST be configured with a random secure string of at least 32 characters in production)
JWT_SECRET=your-strong-random-jwt-secret-min-32-chars-change-in-production

# Admin Account Bootstrapping
# In production, default admin/admin123456 is DISABLED.
# Set BOOTSTRAP_ADMIN=true and provide a strong BOOTSTRAP_ADMIN_PASSWORD for initial deployment only.
BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=your-secure-admin-bootstrap-password

# Allowed CORS Origin (default in production: https://beta.lilyhub.top)
CORS_ORIGIN=https://beta.lilyhub.top

# Optional Phase 5.5 integration. Unset = disabled; manual uploads keep working.
# Never use a VITE_ prefix or expose these values to browsers.
EDITOR_SYNC_SECRET=
# ID of an existing active LilyBeta ADMIN; no browser JWT is shared.
EDITOR_SYNC_ADMIN_ID=
EDITOR_SYNC_SOURCE=editor.lilyhub.top
