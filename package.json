{
  "name": "lilybeta",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"BACKEND_PORT=3006 tsx watch server/index.ts\" \"BACKEND_PORT=3006 CLIENT_PORT=3005 vite\"",
    "dev:server": "BACKEND_PORT=3006 tsx watch server/index.ts",
    "dev:client": "BACKEND_PORT=3006 CLIENT_PORT=3005 vite",
    "server": "BACKEND_PORT=3006 tsx server/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "db:migrate": "tsx server/migrations/runner.ts",
    "db:export-sqlite": "tsx server/migrations/scripts/exportSqlite.ts",
    "db:import-postgres": "tsx server/migrations/scripts/importPostgres.ts",
    "test:security": "tsx tests/idor-security.test.ts",
    "test:renderer": "tsx tests/working-version-renderer.test.ts",
    "test:migrations": "tsx tests/migrations.test.ts",
    "test:drafts": "tsx tests/draft-store.test.ts",
    "test:approved": "tsx tests/approved-version-renderer.test.ts",
    "test:review": "tsx tests/admin-review-security.test.ts",
    "test:egress": "tsx tests/egress-optimization.test.ts",
    "test:readiness": "tsx tests/readiness.test.ts",
    "test:postgres": "tsx tests/postgres-parity.test.ts",
    "test": "npm run test:security && npm run test:renderer && npm run test:migrations && npm run test:drafts && npm run test:approved && npm run test:review && npm run test:egress && npm run test:readiness && npm run test:loading && npm run test:sync && npm run test:sync:postgres && npm run test:mobile && npm run test:export && npm run test:account",
    "test:loading": "tsx tests/loading-resilience.test.ts",
    "test:sync": "tsx tests/editor-sync.test.ts",
    "test:sync:postgres": "SYNC_TEST_PGLITE=true tsx tests/editor-sync.test.ts",
    "test:mobile": "tsx tests/mobile-shell.test.ts",
    "test:export": "tsx tests/export-snapshot.test.ts && tsx tests/document-export.test.ts",
    "test:account": "tsx tests/admin-account.test.ts && ACCOUNT_TEST_PGLITE=true tsx tests/admin-account.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "pdfmake": "^0.2.20",
    "pg": "^8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/node": "^22.13.10",
    "@types/pdfmake": "^0.2.12",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "~5.7.2",
    "vite": "^6.2.0"
  }
}
